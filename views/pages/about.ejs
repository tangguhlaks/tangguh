<div class="container text-white">
   <div class="text-center mb-5">
        <h3 style="color:#66FD0F;" class="fw-bold"><%= config['about-title'] %></h3>
        <h3 class="display-7 fw-semibold mt-3">
            <%- config['about-description'] %>
        </h3>
        <p class="mt-3">
            <%- config['about-sub-description'] %>
        </p>
    </div>
    <hr>
    <br>
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="d-flex flex-column flex-lg-row">
                <!-- Sidebar Tabs -->
                <div class="mb-4 mb-lg-0 me-lg-4 nav nav-pills flex-row flex-lg-column justify-content-center" 
                    id="about-tabs" role="tablist" aria-orientation="vertical">

                    <button class="btn me-2 me-lg-0 mb-lg-3 active" id="skill-tab"
                            data-bs-toggle="pill" data-bs-target="#skill" type="button" role="tab" style="margin: 5px;">
                        Skill
                    </button>
                    <button class="btn me-2 me-lg-0 mb-lg-3" id="experience-tab"
                            data-bs-toggle="pill" data-bs-target="#experience" type="button" role="tab" style="margin: 5px;">
                        Experience
                    </button>
                    <button class="btn me-2 me-lg-0 mb-lg-3" id="education-tab"
                            data-bs-toggle="pill" data-bs-target="#education" type="button" role="tab" style="margin: 5px;">
                        Education
                    </button>
                    <button class="btn" id="interest-tab"
                            data-bs-toggle="pill" data-bs-target="#interest" type="button" role="tab" style="margin: 5px;">
                        Certificate
                    </button>
                </div>
                
                <!-- Content Area -->
                <div class="flex-grow-1 p-4 rounded tab-content" 
                    style="border:1px solid #66FD0F; max-height: 500px; overflow-y: auto;" id="about-tabs-content">
                    <!-- Skill -->
                    <div class="tab-pane fade show active" id="skill" role="tabpanel">
                    <% 
                    var flag=1;
                    skills.forEach(function(skill) { %>
                        <h5 class="<%= flag > 1 ? 'mt-4':'' %>" style="color:#66FD0F;"><%= skill.name %> (<%= skill.level %>)</h5>
                        <p style="text-align: justify;"><%= skill.description %></p>
                    <% }); 
                    flag+=1; %>
                    </div>

                    <!-- Experience -->
                    <div class="tab-pane fade" id="experience" role="tabpanel">
                    <% 
                    var flag=1;
                    experiences.forEach(function(experience) { %>
                        <h5 class="<%= flag > 1 ? 'mt-4':'' %>" style="color:#66FD0F;"><%= experience.name %></h5>
                        <h5 class="mt-2" style="color:#66FD0F;"><%= experience.company_name %> - (<%= experience.start_date+' - '+experience.end_date  %>)</h5>
                        <p style="text-align: justify;"><%= experience.description %></p>
                    <% }); 
                    flag+=1; %>
                    </div>

                    <!-- Education -->
                    <div class="tab-pane fade" id="education" role="tabpanel">
                    <% 
                    var flag=1;
                    educations.forEach(function(education) { %>
                        <h5 class="<%= flag > 1 ? 'mt-4':'' %>" style="color:#66FD0F;"><%= education.school_name %> (<%= education.start_date+' - '+education.end_date  %>)</h5>
                        <p style="text-align: justify;"><%= education.description %></p>
                    <% }); 
                    flag+=1; %>
                    </div>

                    <!-- Interest -->
                    <div class="tab-pane fade" id="interest" role="tabpanel">
                        <h5 style="color:#66FD0F;">Artificial Intelligence</h5>
                        <p>Exploring how machines can see, understand, and learn from the world.</p>

                        <h5 class="mt-4" style="color:#66FD0F;">Technology & Innovation</h5>
                        <p>Passionate about creating impactful solutions that improve everyday life.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br>
    <hr>

</div>