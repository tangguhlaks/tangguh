<div class="row">
  <div class="col-md-12 col-xl-12">
      <div style="display: none;" class="alert alert-success" id="alert-success"></div>
      <div style="display: none;" class="alert alert-danger" id="alert-error"></div>
    <div class="card widget-card-1 text-left" style="padding: 25px;">
        <i class="icofont icofont-graduate bg-c-green card1-icon"></i>   

        <!-- Header -->
        <div class="row mt-5 mb-2">
            <div class="col-md-6">
                <h4>Education</h4>
            </div>
            <div class="col-md-6 text-right">
                <button id="btnAddEducation" class="btn btn-primary">Add Education</button>
            </div>
        </div>         
        <hr class="custom-divider">

        <!-- Table -->
        <table id="educationTable" class="table table-striped table-bordered table-responsive" style="width:100%">
            <thead>
                <tr>
                    <th>#</th>
                    <th width="25%">School / University</th>
                    <th width="15%">Start Date</th>
                    <th width="15%">End Date</th>
                    <th width="45%">Description</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
  </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal fade" id="educationModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add Education</h5>
      </div>
      <div class="modal-body">
        <form id="educationForm">
          <input type="hidden" id="edu_id">
          <div class="mb-3">
            <label for="school_name" class="form-label">School / University</label>
            <input type="text" class="form-control" id="school_name" required>
          </div>
          <div class="mb-3">
            <label for="edu_start_date" class="form-label">Start Date</label>
            <input type="date" class="form-control" id="edu_start_date" required>
          </div>
          <div class="mb-3">
            <label for="edu_end_date" class="form-label">End Date</label>
            <input type="date" class="form-control" id="edu_end_date">
          </div>
          <div class="mb-3">
            <label for="edu_description" class="form-label">Description</label>
            <textarea class="form-control" id="edu_description" rows="3"></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" id="closeEduBtn" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="saveEduBtn" class="btn btn-primary">Save</button>
      </div>
    </div>
  </div>
</div>

<% pageScript = `
<script>
$(document).ready(function() {
    loadEducationTable();
  
    // Tombol Add
    $('#btnAddEducation').on('click', function() {
        $('#educationForm')[0].reset();
        $('#edu_id').val('');
        $('#educationModal .modal-title').text('Add Education');
        $('#educationModal').modal('show');
    });

    // Save button (Add/Edit)
    $('#saveEduBtn').on('click', function() {
      const id = $('#edu_id').val();
      const school_name = $('#school_name').val();
      const start_date = $('#edu_start_date').val();
      const end_date = $('#edu_end_date').val();
      const description = $('#edu_description').val();

      if (!school_name || !start_date) {
          alert('School & Start Date required');
          return;
      }

      if (id) {
          // UPDATE
          $.ajax({
              url: '/education/' + id,
              type: 'PUT',
              contentType: 'application/json',
              data: JSON.stringify({
                  school_name: school_name,
                  start_date: start_date,
                  end_date: end_date,
                  description: description
              }),
              success: function(res) {
                  showAlert('success', res.message);
                  $('#educationTable').DataTable().ajax.reload();
              },
              error: function(err) {
                  console.error(err);
                  showAlert('error', 'Update failed');
              }
          });
      } else {
          // ADD
          $.ajax({
              url: '/education',
              type: 'POST',
              contentType: 'application/json',
              data: JSON.stringify({
                  school_name: school_name,
                  start_date: start_date,
                  end_date: end_date,
                  description: description
              }),
              success: function(res) {
                  showAlert('success', res.message);
                  $('#educationTable').DataTable().ajax.reload();
              },
              error: function(err) {
                  console.error(err);
                  showAlert('error', 'Add failed');
              }
          });
      }

      $('#educationModal').modal('hide');
    });

    $('#closeEduBtn').on('click',function(){
        $('#educationModal').modal('hide');
    });
});

function loadEducationTable(){
     var table = $('#educationTable').DataTable({
        ajax: '/education/list',
        columns: [
            { 
                data: null, 
                render: function(data, type, row, meta){
                    return meta.row + 1; // nomor urut
                }
            },
            { data: 'school_name' },
            { data: 'start_date' },
            { data: 'end_date' },
            { data: 'description' },
            { 
              data: null,
              render: function(data, type, row) {
                  return '<button class="btn btn-sm btn-warning btn-edit" data-id="' + data.id + '">Edit</button>' +
                         ' <button class="btn btn-sm btn-danger btn-delete" data-id="' + data.id + '">Delete</button>';
              }
            }
        ]
    });

    // Event edit
    $('#educationTable tbody').on('click', '.btn-edit', function() {
        var data = table.row($(this).parents('tr')).data();
        $('#edu_id').val(data.id);
        $('#school_name').val(data.school_name);
        $('#edu_start_date').val(data.start_date);
        $('#edu_end_date').val(data.end_date);
        $('#edu_description').val(data.description);
        $('#educationModal .modal-title').text('Edit Education');
        $('#educationModal').modal('show');
    });

    // Event delete
    $('#educationTable tbody').on('click', '.btn-delete', function() {
        var data = table.row($(this).parents('tr')).data();
        if(confirm('Delete education at: ' + data.school_name + '?')) {
            $.ajax({
                url: '/education/' + data.id,
                type: 'DELETE',
                success: function(res) {
                    showAlert('success',res.message);
                    table.ajax.reload();
                }
            });
        }
    });
}

// Reuse showAlert
function showAlert(type, message){
    var alertEl = $("#alert-" + type);
    alertEl.html(message);
    alertEl.show();
    setTimeout(function(){ alertEl.fadeOut(); }, 3000);
}
</script>
` %>
