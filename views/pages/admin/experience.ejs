<div class="row">
  <div class="col-md-12 col-xl-12">
      <div style="display: none;" class="alert alert-success" id="alert-success"></div>
      <div style="display: none;" class="alert alert-danger" id="alert-error"></div>
    <div class="card widget-card-1 text-left" style="padding: 25px;">
        <i class="icofont icofont-briefcase bg-c-blue card1-icon"></i>   

        <!-- Header -->
        <div class="row mt-5 mb-2">
            <div class="col-md-6">
                <h4>Experience</h4>
            </div>
            <div class="col-md-6 text-right">
                <button id="btnAddExperience" class="btn btn-primary">Add Experience</button>
            </div>
        </div>         
        <hr class="custom-divider">

        <!-- Table -->
        <table id="experienceTable" class="table table-striped table-bordered table-responsive" style="width:100%">
            <thead>
                <tr>
                    <th>#</th>
                    <th width="20%">Name</th>
                    <th width="20%">Company</th>
                    <th width="10%">Start Date</th>
                    <th width="20%">End Date</th>
                    <th width="50%">Description</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
  </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal fade" id="experienceModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add Experience</h5>
      </div>
      <div class="modal-body">
        <form id="experienceForm">
          <input type="hidden" id="exp_id">
          <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <input type="text" class="form-control" id="name" required>
          </div>
          <div class="mb-3">
            <label for="company_name" class="form-label">Company Name</label>
            <input type="text" class="form-control" id="company_name" required>
          </div>
          <div class="mb-3">
            <label for="start_date" class="form-label">Start Date</label>
            <input type="date" class="form-control" id="start_date" required>
          </div>
          <div class="mb-3">
            <label for="end_date" class="form-label">End Date</label>
            <input type="date" class="form-control" id="end_date">
          </div>
          <div class="mb-3">
            <label for="exp_description" class="form-label">Description</label>
            <textarea class="form-control" id="exp_description" rows="3"></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" id="closeExpBtn" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="saveExpBtn" class="btn btn-primary">Save</button>
      </div>
    </div>
  </div>
</div>

<% pageScript = `
<script>
$(document).ready(function() {
    loadExperienceTable();
  
    // Tombol Add Experience
    $('#btnAddExperience').on('click', function() {
        $('#experienceForm')[0].reset();
        $('#exp_id').val('');
        $('#experienceModal .modal-title').text('Add Experience');
        $('#experienceModal').modal('show');
    });

    // Save button (Add/Edit)
    $('#saveExpBtn').on('click', function() {
      const id = $('#exp_id').val();
      const name = $('#name').val();
      const company_name = $('#company_name').val();
      const start_date = $('#start_date').val();
      const end_date = $('#end_date').val();
      const description = $('#exp_description').val();

      if (!name || !company_name || !start_date) {
          alert('Company & Start Date required');
          return;
      }

      if (id) {
          // UPDATE
          $.ajax({
              url: '/experience/' + id,
              type: 'PUT',
              contentType: 'application/json',
              data: JSON.stringify({
                  name: name,
                  company_name: company_name,
                  start_date: start_date,
                  end_date: end_date,
                  description: description
              }),
              success: function(res) {
                  showAlert('success', res.message);
                  $('#experienceTable').DataTable().ajax.reload();
              },
              error: function(err) {
                  console.error(err);
                  showAlert('error', 'Update failed');
              }
          });
      } else {
          // ADD
          $.ajax({
              url: '/experience',
              type: 'POST',
              contentType: 'application/json',
              data: JSON.stringify({
                  name: name,
                  company_name: company_name,
                  start_date: start_date,
                  end_date: end_date,
                  description: description
              }),
              success: function(res) {
                  showAlert('success', res.message);
                  $('#experienceTable').DataTable().ajax.reload();
              },
              error: function(err) {
                  console.error(err);
                  showAlert('error', 'Add failed');
              }
          });
      }

      $('#experienceModal').modal('hide');
    });

    $('#closeExpBtn').on('click',function(){
        $('#experienceModal').modal('hide');
    });
});

function loadExperienceTable(){
     var table = $('#experienceTable').DataTable({
        ajax: '/experience/list',
        columns: [
            { 
                data: null, 
                render: function(data, type, row, meta){
                    return meta.row + 1; // nomor urut
                }
            },
            { data: 'name' },
            { data: 'company_name' },
            { data: 'start_date' },
            { data: 'end_date' },
            { data: 'description' },
            { 
              data: null,
              render: function(data, type, row) {
                  return '<button class="btn btn-sm btn-warning btn-edit" data-id="' + data.id + '">Edit</button>' +
                         ' <button class="btn btn-sm btn-danger btn-delete" data-id="' + data.id + '">Delete</button>';
              }
            }
        ]
    });

    // Event edit
    $('#experienceTable tbody').on('click', '.btn-edit', function() {
        var data = table.row($(this).parents('tr')).data();
        $('#exp_id').val(data.id);
        $('#name').val(data.name);
        $('#company_name').val(data.company_name);
        $('#start_date').val(data.start_date);
        $('#end_date').val(data.end_date);
        $('#exp_description').val(data.description);
        $('#experienceModal .modal-title').text('Edit Experience');
        $('#experienceModal').modal('show');
    });

    // Event delete
    $('#experienceTable tbody').on('click', '.btn-delete', function() {
        var data = table.row($(this).parents('tr')).data();
        if(confirm('Delete experience at: ' + data.name + '?')) {
            $.ajax({
                url: '/experience/' + data.id,
                type: 'DELETE',
                success: function(res) {
                    showAlert('success',res.message);
                    table.ajax.reload();
                }
            });
        }
    });
}

// Reuse showAlert from skill page
function showAlert(type, message){
    var alertEl = $("#alert-" + type);
    alertEl.html(message);
    alertEl.show();
    setTimeout(function(){ alertEl.fadeOut(); }, 3000);
}
</script>
` %>
