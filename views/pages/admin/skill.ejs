<div class="row">
  <div class="col-md-12 col-xl-12">
      <div style="display: none;" class="alert alert-success" id="alert-success"></div>
      <div style="display: none;" class="alert alert-danger" id="alert-error"></div>
    <div class="card widget-card-1 text-left" style="padding: 25px;">
        <i class="icofont icofont-star bg-c-blue card1-icon"></i>   

        <!-- Header -->
        <div class="row mt-5 mb-2">
            <div class="col-md-6">
                <h4>Skill</h4>
            </div>
            <div class="col-md-6 text-right">
                <button id="btnAddSkill" class="btn btn-primary">Add Skill</button>
            </div>
        </div>         
        <hr class="custom-divider">

        <!-- Table -->
        <table id="skillTable" class="table table-striped table-bordered table-responsive" style="width:100%">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Level</th>
                    <th>Description</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
  </div>
</div>>

<!-- Add/Edit Modal -->
<div class="modal fade" id="skillModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add Skill</h5>
      </div>
      <div class="modal-body">
        <form id="skillForm">
          <input type="hidden" id="id">
          <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <input type="text" class="form-control" id="name" required>
          </div>
          <div class="mb-3">
            <label for="level" class="form-label">Level</label>
            <input type="text" class="form-control" id="level" required>
          </div>
          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea class="form-control" id="description" rows="3"></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" id="closebtn" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="savebtn" class="btn btn-primary">Save</button>
      </div>
    </div>
  </div>
</div>

<% pageScript = `
<script>
$(document).ready(function() {
    loadTable();
  
    // Tombol Add Skill
    $('#btnAddSkill').on('click', function() {
        $('#skillForm')[0].reset();
        $('#id').val('');
        $('#skillModal .modal-title').text('Add Skill');
        $('#skillModal').modal('show');
    });

    // Save button (Add/Edit)
    $('#savebtn').on('click', function() {
      const id = $('#id').val();
      const name = $('#name').val();
      const level = $('#level').val();
      const description = $('#description').val();

      if (!name || !level) {
          alert('Skill name & level required');
          return;
      }

      if (id) {
          // UPDATE
          $.ajax({
              url: '/skill/' + id,
              type: 'PUT',
              contentType: 'application/json',
              data: JSON.stringify({
                  name: name,
                  level: level,
                  description: description
              }),
              success: function(res) {
                  showAlert('success',res.message);
                  $('#skillTable').DataTable().ajax.reload();
              },
              error: function(err) {
                  console.error(err);
                  showAlert('error',res.message);
              }
          });
      } else {
          // ADD
          $.ajax({
              url: '/skill',
              type: 'POST',
              contentType: 'application/json',
              data: JSON.stringify({
                  name: name,
                  level: level,
                  description: description
              }),
              success: function(res) {
                  showAlert('success',res.message);
                  $('#skillTable').DataTable().ajax.reload();
              },
              error: function(err) {
                  console.error(err);
                  showAlert('error',res.message);
              }
          });
      }

      $('#skillModal').modal('hide');
    });

    $('#closebtn').on('click',function(){
        $('#skillModal').modal('hide');
    })
});

function showAlert(type, message){
    // type = 'success' atau 'error'
    var alertEl = $("#alert-" + type);
    alertEl.html(message);   // set pesan
    alertEl.show();          // tampilkan (display:block)

    // Optional: hide setelah 3 detik
    setTimeout(function(){
        alertEl.fadeOut();
    }, 3000);
}


function loadTable(){
     var table = $('#skillTable').DataTable({
        ajax: '/skill/list',
        columns: [
            { 
                data: null, 
                render: function(data, type, row, meta){
                    return meta.row + 1; // nomor urut mulai dari 1
                }
            },
            { data: 'name' },
            { data: 'level' },
            { data: 'description' },
            { 
              data: null,
              render: function(data, type, row) {
                  return '<button class="btn btn-sm btn-warning btn-edit" data-id="' + data.id + '">Edit</button>' +
                         ' <button class="btn btn-sm btn-danger btn-delete" data-id="' + data.id + '">Delete</button>';
              }
            }
        ]
    });

     // Event edit
    $('#skillTable tbody').on('click', '.btn-edit', function() {
        var data = table.row($(this).parents('tr')).data();
        $('#id').val(data.id);
        $('#name').val(data.name);
        $('#level').val(data.level);
        $('#description').val(data.description);
        $('#skillModal .modal-title').text('Edit Skill');
        $('#skillModal').modal('show');
    });

    // Event delete
    $('#skillTable tbody').on('click', '.btn-delete', function() {
        var data = table.row($(this).parents('tr')).data();
        if(confirm('Delete skill: ' + data.name + '?')) {
            $.ajax({
                url: '/skill/' + data.id,
                type: 'DELETE',
                success: function(res) {
                    showAlert('success',res.message);
                    table.ajax.reload();
                }
            });
        }
    });
}

</script>
` %>