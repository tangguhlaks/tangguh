<div class="row">
  <div class="col-md-12 col-xl-12">
    <% if (success_msg.length > 0) { %>
      <div class="alert alert-success"><%= success_msg %></div>
    <% } %>

    <% if (error_msg.length > 0) { %>
      <div class="alert alert-danger"><%= error_msg %></div>
    <% } %>

    <!-- Form start -->
    <form action="/configuration/save" method="POST" enctype="multipart/form-data">
      <div class="card widget-card-1 text-left" style="padding: 25px;">
        <i class="icofont icofont-settings bg-c-blue card1-icon"></i>   

        <!-- Home Page -->
        <div class="row mt-5">
          <h4 class="col-md-12 mt-2">Home Page Configuration</h4>
        </div>         
        <hr class="custom-divider">

        <div class="row mt-3">
          <label class="col-md-2 mt-2">Profile Photo</label>
          <input type="file" name="profile-photo" class="form-control col-md-10">
        </div>

        <div class="row mt-3">
          <label class="col-md-2 mt-2">Fullname</label>
          <input type="text" name="full-name" class="form-control col-md-10" 
                 placeholder="Fullname" value="<%= config['full-name'] || '' %>">
        </div>

        <div class="row mt-3">
          <label class="col-md-2 mt-2">Job Titles</label>
          <input type="text" name="job-titles" class="form-control col-md-10" 
                 placeholder="Job Titles (example: .Net Engineer, AI Engineer)" 
                 value="<%= config['job-titles'] || '' %>">
        </div>

        <div class="row mt-3">
          <label class="col-md-2 mt-2">Description</label>
          <textarea name="home-description" class="form-control col-md-10 summernote"><%= config['home-description'] || '' %></textarea>
        </div>

        <div class="row mt-3">
          <label class="col-md-2 mt-2">CV</label>
          <input type="file" name="cv" class="form-control col-md-10">
          
        </div>

        <!-- About Page -->
        <hr class="custom-divider">
        <div class="row mt-5">
          <h4 class="col-md-12 mt-2">About Page Configuration</h4>
        </div>         
        <hr class="custom-divider">

        <div class="row mt-3">
          <label class="col-md-2 mt-2">Title</label>
          <input type="text" name="about-title" class="form-control col-md-10" value="<%= config['about-title'] || '' %>" placeholder="Title">
        </div>

        <div class="row mt-3">
          <label class="col-md-2 mt-2">Description</label>
          <textarea name="about-description" class="form-control col-md-10 summernote"><%= config['about-description'] || '' %></textarea>
        </div>

        <div class="row mt-3">
          <label class="col-md-2 mt-2">Sub Description</label>
          <textarea name="about-sub-description" class="form-control col-md-10 summernote"><%= config['about-sub-description'] || '' %></textarea>
        </div>

        <!-- Portfolio Page -->
        <hr class="custom-divider">
        <div class="row mt-5">
          <h4 class="col-md-12 mt-2">Portfolio Page Configuration</h4>
        </div>         
        <hr class="custom-divider">

        <div class="row mt-3">
          <label class="col-md-2 mt-2">Title</label>
          <input type="text" name="portfolio-title" class="form-control col-md-10" value="<%= config['portfolio-title'] || '' %>" placeholder="Title">
        </div>

        <div class="row mt-3">
          <label class="col-md-2 mt-2">Description</label>
          <textarea name="portfolio-description" class="form-control col-md-10 summernote"><%= config['portfolio-description'] || '' %></textarea>
        </div>

        <div class="row mt-3">
          <label class="col-md-2 mt-2">Sub Description</label>
          <textarea name="portfolio-sub-description" class="form-control col-md-10 summernote"><%= config['portfolio-sub-description'] || '' %></textarea>
        </div>

        <!-- Blog Page -->
        <hr class="custom-divider">
        <div class="row mt-5">
          <h4 class="col-md-12 mt-2">Blog Page Configuration</h4>
        </div>         
        <hr class="custom-divider">

        <div class="row mt-3">
          <label class="col-md-2 mt-2">Title</label>
          <input type="text" name="blog-title" class="form-control col-md-10" value="<%= config['blog-title'] || '' %>" placeholder="Title">
        </div>

        <div class="row mt-3">
          <label class="col-md-2 mt-2">Description</label>
          <textarea name="blog-description" class="form-control col-md-10 summernote"><%= config['blog-description'] || '' %></textarea>
        </div>

        <!-- Contact Page -->
        <hr class="custom-divider">
        <div class="row mt-5">
          <h4 class="col-md-12 mt-2">Contact Page Configuration</h4>
        </div>         
        <hr class="custom-divider">
        <div class="row mt-3">
          <label class="col-md-2 mt-2">Title</label>
          <input type="text" name="contact-title" class="form-control col-md-10" value="<%= config['contact-title'] || '' %>" placeholder="Title">
        </div>

        <div class="row mt-3">
          <label class="col-md-2 mt-2">Description</label>
          <textarea name="contact-description" class="form-control col-md-10 summernote"><%= config['contact-description'] || '' %></textarea>
        </div>
        <div class="row mt-3">
          <label class="col-md-2 mt-2">GitHub</label>
          <input type="text" name="github" class="form-control col-md-10" value="<%= config['github'] || '' %>" placeholder="Github">
        </div>

        <div class="row mt-3">
          <label class="col-md-2 mt-2">Linkedin</label>
          <input type="text" name="linkedin" class="form-control col-md-10" value="<%= config['linkedin'] || '' %>" placeholder="Linkedin">
        </div>

        <div class="row mt-3">
          <label class="col-md-2 mt-2">Instagram</label>
          <input type="text" name="instagram" class="form-control col-md-10" value="<%= config['instagram'] || '' %>" placeholder="Instagram">
        </div>

        <div class="row mt-3">
          <label class="col-md-2 mt-2">WhatsApp</label>
          <input type="text" name="whatsapp" class="form-control col-md-10" value="<%= config['whatsapp'] || '' %>" placeholder="WhatsApp">
        </div>

        <div class="row mt-3">
          <label class="col-md-2 mt-2">Email</label>
          <input type="text" name="email" class="form-control col-md-10" value="<%= config['email'] || '' %>" placeholder="Email">
        </div>

        <!-- Submit Button -->
        <hr class="custom-divider">
        <div class="row" style="padding: 10px;">
          <div class="col d-flex justify-content-end">
            <button type="submit" class="btn btn-primary">Save Configuration</button>
          </div>
        </div>

      </div>
    </form>
    <!-- Form end -->
  </div>
</div>
